{
  "name": "SSK-orderpakketten",
  "description": "Controleer afgeronde CCV-bestellingen en maak de productieoverdracht. Mail blijft uit zonder geconfigureerde en ingeschakelde verzendverbinding.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ssk_production_packets",
      "version": "1.0.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_config": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ssk-production-v1",
            "args": {
              "action": "config"
            }
          },
          "then": "prepare_recent_pair"
        }
      },
      {
        "prepare_recent_pair": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ssk-production-v1",
            "args": {
              "action": "prepare",
              "id": "6af9fa6285575a901e3af2ae"
            }
          },
          "then": "prepare_earlier_pair"
        }
      },
      {
        "prepare_earlier_pair": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ssk-production-v1",
            "args": {
              "action": "prepare",
              "id": "6af897349fa05db9689a8bb8"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}