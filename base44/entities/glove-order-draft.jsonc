{
  "name":"GloveOrderDraft","type":"object",
  "properties":{
    "reference":{"type":"string"},"design":{"type":"object"},"quote":{"type":"object"},
    "previews":{"type":"array","items":{"type":"object"}},
    "view_hash":{"type":"string"},"checkout_hash":{"type":"string"},"client_hash":{"type":"string"},
    "expires_at":{"type":"string"},"status":{"type":"string","enum":["draft","submitting","ready","uncertain","ordered"]},
    "ccv_order_id":{"type":"number"},"checkout_url":{"type":"string"},"last_error":{"type":"string"}
  },
  "required":["reference","design","quote","previews","view_hash","checkout_hash","client_hash","expires_at","status"],
  "rls":{
    "create":{"user_condition":{"role":"admin"}},"read":{"user_condition":{"role":"admin"}},
    "update":{"user_condition":{"role":"admin"}},"delete":{"user_condition":{"role":"admin"}}
  }
}
